# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจาก Supabase Dashboard
# Project Settings → API Keys (หรือปุ่ม Connect ด้านบนของ Dashboard)
#
# ใช้ได้เฉพาะ publishable key (sb_publishable_...) หรือ anon key เท่านั้น
# ห้ามใส่ secret key / service_role key ในหน้าเว็บเด็ดขาด

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ขั้นที่ 8: LIFF ID จาก LINE Developers (ช่องทาง LINE Login → แท็บ LIFF) เช่น 2001234567-AbCdEfGh
# ไม่ใช่ความลับ (อยู่ในลิงก์ https://liff.line.me/<LIFF ID> ที่แจกผู้เช่าอยู่แล้ว)
VITE_LIFF_ID=

# โหมดจำลอง LIFF สำหรับทดสอบหน้าตาเท่านั้น — ห้ามตั้งใน Vercel
# VITE_LIFF_MOCK=true
