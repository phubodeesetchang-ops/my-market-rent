# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจาก Supabase Dashboard
# Project Settings → API Keys (หรือปุ่ม Connect ด้านบนของ Dashboard)
#
# ใช้ได้เฉพาะ publishable key (sb_publishable_...) หรือ anon key เท่านั้น
# ห้ามใส่ secret key / service_role key ในหน้าเว็บเด็ดขาด

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
